# LLM Settings (Google Gemini - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Hunter.io Settings
HUNTER_API_KEY=your_hunter_key_here

# Prospeo Settings
PROSPEO_API_KEY=your_prospeo_key_here

# Snov.io Settings
SNOV_CLIENT_ID=your_snov_client_id_here
SNOV_CLIENT_SECRET=your_snov_secret_here

# Local app URL
APP_BASE_URL=http://localhost:8000

# LinkedIn OAuth Settings
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202510
LINKEDIN_ACCOUNT_ID=local-user
TOKEN_EXPIRY_WARNING_DAYS=7

# Optional legacy fallback only. Prefer OAuth + Supabase above.
LINKEDIN_ACCESS_TOKEN=

# Supabase Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
LINKEDIN_TOKEN_ENCRYPTION_KEY=use_a_long_random_secret_here

# Gmail Settings
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=your_email@gmail.com

# Playwright Settings
# Do not run headless for LinkedIn, as it increases bot detection risk
HEADLESS=False
