# LinkedIn OAuth — register at https://developer.linkedin.com/
# Products required for multi-destination publish (TS-2):
#   - Sign In with LinkedIn using OpenID Connect
#   - Share on LinkedIn (w_member_social) — required for personal publish
#   - Community Management / organization social — required for Page publish
# Default scopes are PERSONAL ONLY. LinkedIn returns
#   Scope "w_organization_social" is not authorized for your application
# if you request org scopes before the product is approved on the app.
# After approval, set:
#   LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social w_organization_social
LINKEDIN_CLIENT_ID=your-linkedin-client-id-here
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret-here
LINKEDIN_REDIRECT_URI=http://localhost:8005/auth/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
# Marketing API month version (YYYYMM). Must be a currently supported LinkedIn version.
LINKEDIN_API_VERSION=202608

# AI APIs
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

GROK_API_KEY=your-grok-api-key-here
GROK_IMAGE_MODEL=grok-2-image

# Adaptive Content DNA onboarding (TS-12)
ONBOARDING_MIN_QUESTIONS=6
ONBOARDING_MAX_QUESTIONS=14
ONBOARDING_TARGET_COVERAGE=0.80

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/linkedin_agent

# Supabase Storage (for generated images)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=linkedin-agent-images

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
ADMIN_JWT_SECRET=
ADMIN_PASSWORD=changeme123

# User sessions (customer sign-in). Falls back to ADMIN_JWT_SECRET when blank; set it
# separately in production so rotating staff access does not sign out every customer.
USER_JWT_SECRET=
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=antgrav_session

# ---------------------------------------------------------------------------
# Email OTP sign-in / sign-up
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_EMAIL_HOUR=5
OTP_MAX_PER_IP_HOUR=20
# Extra secret mixed into the OTP hash. Falls back to ADMIN_JWT_SECRET when blank.
OTP_HASH_PEPPER=

# LOCAL DEVELOPMENT ONLY. When true, the fixed code below is accepted in addition to
# the real one, and codes are printed to the backend log instead of being emailed.
# A code must still have been requested first — this does not let anyone sign in as
# an arbitrary address. MUST be false (or absent) in production.
OTP_DEV_MODE=false
OTP_DEV_CODE=123456

# ---------------------------------------------------------------------------
# SMTP — leave SMTP_HOST blank to log emails instead of sending them.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@antgrav.local
SMTP_FROM_NAME=AntGrav
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# LOCAL DEVELOPMENT ONLY. Restores the pre-007 behaviour of handing an authenticated
# session to any caller that does not have one, and re-enables /auth/dev-connect.
# Leave false so the real sign-in flow is what you hit.
DEV_AUTH_BYPASS=false

# Platform integration (set when running under DelegtLabs platform)
# Generate a shared secret: openssl rand -hex 32
LINKEDIN_SERVICE_TOKEN=
LINKEDIN_SIDECAR_URL=http://linkedin-backend:8005
# Set to "true" to disable internal APScheduler when platform worker handles scheduling
# In-process scheduler also runs generate_job hourly UTC.
DISABLE_SCHEDULER=false

# Razorpay (one-time Orders for plans and credit packs). INR only.
# Dashboard: https://dashboard.razorpay.com/app/keys
# Webhook URL: {BACKEND_URL}/webhooks/razorpay  events: payment.captured, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server
PORT=8005
NODE_ENV=development
FRONTEND_URL=http://localhost:3005
BACKEND_URL=http://localhost:8005
