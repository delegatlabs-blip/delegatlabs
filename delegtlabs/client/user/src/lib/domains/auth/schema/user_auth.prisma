/// Table: user_auth — User portal credentials (adminId → admin_customers.id / user id)
model UserAuth {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  password     String   @default("")
  roleId       String   @map("role_id") @db.Uuid
  permissionId String?  @map("permission_id") @db.Uuid
  adminId      String   @unique @map("admin_id") @db.Uuid
  mustReset    Boolean  @default(true) @map("must_reset")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  role Role          @relation(fields: [roleId], references: [id])
  user AdminCustomer @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("user_auth")
}
