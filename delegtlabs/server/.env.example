APP_NAME=DelegtLabs
APP_ENV=development
APP_VERSION=0.1.0
API_VERSION=v1
DEBUG=true
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:8080,http://localhost:8081

# Local Postgres — docker compose maps db → localhost:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/delegtlabs

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

ADMIN_REQUIRED_ROLE=ops_admin
DISABLE_ADMIN_AUTH=true
DISABLE_USER_AUTH=false
