APP_NAME=DelegtLabs
APP_ENV=development
APP_VERSION=0.1.0
API_VERSION=v1
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Comma-separated origins for browser clients
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database (placeholder — wire when ready)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/delegtlabs

# Auth (placeholder)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
SUPABASE_JWKS_URL=https://project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://project-id.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
ADMIN_REQUIRED_ROLE=ops_admin
DISABLE_ADMIN_AUTH=false
